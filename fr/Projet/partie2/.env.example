# === API Unsplash ===
# Remplacer par votre propre clé API (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_access_key_here

# === Tuning Spark (optionnel — valeurs par défaut conviennent à la démo) ===
# Augmenter pour gros datasets / machine puissante.
# SPARK_PARALLELISM=200
# SPARK_DRIVER_MEMORY=2g
# SPARK_EXECUTOR_MEMORY=2g

# === Hyperparamètres MLlib RandomForest (recommandation) ===
# RF_NUM_TREES=100
# RF_MAX_DEPTH=10
# RF_MAX_BINS=256   # >= max(unique values) des features catégorielles
# NEG_POS_RATIO=3   # Ratio négatifs/positifs pour le training (modèle global)
